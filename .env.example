# Database
# Postgres connection string (e.g. from Supabase/Neon/Vercel Postgres)
# Create a Postgres database and paste the connection string here
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT session secret - generate a strong one for production
# Use: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-strong-secret"
JWT_SECRET="change-me-to-another-strong-secret"

# Master admin secret key for /chismis-admin
ADMIN_SECRET="CHANGE-ME-ADMIN-MASTER-KEY"
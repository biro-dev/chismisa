# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/chismisa"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
# Master secret for the admin panel at /chismis-admin
ADMIN_SECRET="replace-with-another-long-random-string"

# ─── Pusher (real-time messaging) — optional ────────────────────────────────
# Without these the app falls back to 30s polling for new messages.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ─── Firebase Cloud Messaging (push notifications) — optional ───────────────
# Full service-account JSON (single line, escaped) for server-side FCM sends
FIREBASE_SERVICE_ACCOUNT=""
# VAPID key for web push subscriptions (Firebase console → Cloud Messaging)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Database
# Postgres connection string (e.g. from Supabase/Neon/Vercel Postgres)
# Create a Postgres database and paste the connection string here
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT session secret - generate a strong one for production
# Use: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-strong-secret"

# Master admin secret key for /chismis-admin
ADMIN_SECRET="CHANGE-ME-ADMIN-MASTER-KEY"

# Firebase service account JSON path (for FCM push notifications — server side)
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT=./path/to/service-account.json

# Firebase web app VAPID public key (for web/PWA push notifications)
# Generate at: Firebase Console → Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY="YOUR_VAPID_PUBLIC_KEY"

# Firebase web app config (safe to expose — public values only)
NEXT_PUBLIC_FIREBASE_APP_ID="1:YOUR_PROJECT_ID:web:YOUR_WEB_APP_ID"

# --- Pusher Channels (real-time messaging) ---
# 1. Sign up at https://pusher.com — free tier (100 concurrent users)
# 2. Create a Channels app → copy the keys below
# 3. Add these to your Vercel Environment Variables

# Server-only — never expose SECRET to the client
PUSHER_APP_ID="YOUR_PUSHER_APP_ID"
PUSHER_SECRET="YOUR_PUSHER_APP_SECRET"

# Client-safe — prefixed with NEXT_PUBLIC_ so they're inlined at build time
NEXT_PUBLIC_PUSHER_KEY="YOUR_PUSHER_APP_KEY"
NEXT_PUBLIC_PUSHER_CLUSTER="YOUR_CLUSTER"
ANALYTICS_SECRET="replace-with-another-random-string"
